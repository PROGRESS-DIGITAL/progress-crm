# Домен, который смотрит на сервер (A-запись), например crm.progrs.ru
DOMAIN=crm.progrs.ru
POSTGRES_PASSWORD=длинный-случайный-пароль
# Ключ для webhook Тильды: https://crm.progrs.ru/api/webhooks/tilda?key=...
TILDA_WEBHOOK_KEY=длинная-случайная-строка
# Ключ для первой настройки входа директора: его спросят на странице входа, пока пароль директора не задан
SETUP_KEY=длинная-случайная-строка
# 1 — добавить демо-сделки при первом запуске
SEED_DEMO=0
# Если Telegram с сервера недоступен: HTTP-прокси, например http://user:pass@host:port
TELEGRAM_PROXY=
