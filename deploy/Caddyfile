# Если сайт открывают через промежуточный сервер (deploy/relay.sh), он передаёт настоящий адрес
# посетителя по протоколу PROXY: без этого журнал входов и защита от перебора видели бы один адрес на всех.
# RELAY_IP в deploy/.env — адрес промежуточного сервера; заголовок PROXY принимается только от него (порт 443)
{
	servers {
		listener_wrappers {
			proxy_protocol {
				allow {$RELAY_IP:127.0.0.1/32}
			}
			tls
		}
	}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy app:3000
}
