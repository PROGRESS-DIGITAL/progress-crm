generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum Service {
  WEBSITE
  SEO
  CONTEXT_ADS
  BRANDING
  SMM
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  REJECTED
}

enum LeadSource {
  TILDA
  MANUAL
}

model Lead {
  id           String     @id @default(cuid())
  status       LeadStatus @default(NEW)
  source       LeadSource @default(MANUAL)
  name         String?
  phone        String?
  email        String?
  companyName  String?
  message      String?
  formName     String?
  pageUrl      String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  // Номер заявки Тильды: защищает от дублей при повторной доставке
  externalId   String?    @unique
  // Все поля заявки как пришли, чтобы ничего не потерять при разборе
  raw          Json?
  owner        String?
  rejectReason String?
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId       String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}

// Услуга из прайса агентства (progrs.ru/price)
model Product {
  id          String   @id @default(cuid())
  category    String
  name        String
  description String?
  price       Int // рубли
  // «от 150 000»: цена минимальная, итог зависит от проекта
  // Единица для почасовых и постраничных услуг: «час», «страница»
  unit        String?
  service     Service  @default(OTHER)
  // Шаг планограммы продаж (ключ из lib/sales-map.ts)
  salesStep   String?
  sortOrder   Int      @default(0)
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
}

model Stage {
  id    String    @id @default(cuid())
  name  String
  order Int
  kind  StageKind @default(OPEN)
  deals Deal[]

  @@unique([order])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  inn       String?
  kpp       String?
  ogrn      String?
  // Руководитель по данным ЕГРЮЛ: ФИО и должность
  director  String?
  website   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  // Ситуация клиента в планограмме; пусто — определяется по оплаченным сделкам
  situation String?
  contacts  Contact[]
  deals     Deal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String
  position  String?
  phone     String?
  email     String?
  notes     String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  company           Company   @relation(fields: [companyId], references: [id])
  companyId         String
  // Контакт удаляется — сделка остаётся без контакта
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId         String?
  // Услуга из прайса; сумма сделки копирует цену и дальше правится независимо
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId         String?
  quantity          Int       @default(1)
  amount            Int       @default(0) // рубли
  service           Service   @default(WEBSITE)
  salesStep         String?
  owner             String?
  // Когда начали работать по сделке; по умолчанию — дата создания
  startDate         DateTime  @default(now())
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  // Порядок карточки внутри колонки: меньше — выше
  position          Float     @default(0)
  lead              Lead?
  stage             Stage     @relation(fields: [stageId], references: [id])
  stageId           String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stageId, position])
  @@index([companyId])
}

// Настройки приёма заявок с Тильды: одна строка с id = 1
model TildaSettings {
  id         Int      @id @default(1)
  enabled    Boolean  @default(true)
  webhookKey String
  // Какие поля формы Тильды попадают в какие поля лида
  fieldMap   Json
  updatedAt  DateTime @updatedAt
}

// Журнал входящих запросов webhook: помогает настроить поля и понять, почему заявка не дошла
model WebhookLog {
  id        String   @id @default(cuid())
  source    String
  status    String
  fields    Json
  leadId    String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// Простые настройки приложения: ключи внешних сервисов и т. п.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Сотрудник CRM. Пока вход общий, владелец — один: его карточка в «Личных данных»
model Employee {
  id        String   @id @default(cuid())
  name      String
  position  String?
  phone     String?
  email     String?
  // Аватар как data URL: сжимается в браузере до 256 px, чтобы не держать файлы на диске
  avatar    String?
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
