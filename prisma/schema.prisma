generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum Service {
  WEBSITE
  SEO
  CONTEXT_ADS
  BRANDING
  SMM
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  REJECTED
}

enum LeadSource {
  TILDA
  MANUAL
}

model Lead {
  id           String     @id @default(cuid())
  status       LeadStatus @default(NEW)
  source       LeadSource @default(MANUAL)
  name         String?
  phone        String?
  email        String?
  companyName  String?
  message      String?
  formName     String?
  pageUrl      String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  // Номер заявки Тильды: защищает от дублей при повторной доставке
  externalId   String?    @unique
  // Все поля заявки как пришли, чтобы ничего не потерять при разборе
  raw          Json?
  owner        String?
  rejectReason String?
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId       String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}

model Stage {
  id       String    @id @default(cuid())
  name     String
  order    Int
  kind     StageKind @default(OPEN)
  deals    Deal[]

  @@unique([order])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  inn       String?
  website   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  contacts  Contact[]
  deals     Deal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String
  position  String?
  phone     String?
  email     String?
  notes     String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  company           Company   @relation(fields: [companyId], references: [id])
  companyId         String
  // Контакт удаляется — сделка остаётся без контакта
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId         String?
  amount            Int       @default(0) // рубли
  service           Service   @default(WEBSITE)
  owner             String?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  // Порядок карточки внутри колонки: меньше — выше
  position          Float     @default(0)
  lead              Lead?
  stage             Stage     @relation(fields: [stageId], references: [id])
  stageId           String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stageId, position])
  @@index([companyId])
}
