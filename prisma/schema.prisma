generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum Service {
  WEBSITE
  SEO
  CONTEXT_ADS
  BRANDING
  SMM
  OTHER
}

model Stage {
  id       String    @id @default(cuid())
  name     String
  order    Int
  kind     StageKind @default(OPEN)
  deals    Deal[]

  @@unique([order])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  inn       String?
  website   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  contacts  Contact[]
  deals     Deal[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String
  position  String?
  phone     String?
  email     String?
  notes     String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  company           Company   @relation(fields: [companyId], references: [id])
  companyId         String
  // Контакт удаляется — сделка остаётся без контакта
  contact           Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId         String?
  amount            Int       @default(0) // рубли
  service           Service   @default(WEBSITE)
  owner             String?
  expectedCloseDate DateTime?
  lostReason        String?
  notes             String?
  // Порядок карточки внутри колонки: меньше — выше
  position          Float     @default(0)
  stage             Stage     @relation(fields: [stageId], references: [id])
  stageId           String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stageId, position])
  @@index([companyId])
}
