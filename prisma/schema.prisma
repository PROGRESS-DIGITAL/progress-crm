generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum Service {
  WEBSITE
  SEO
  CONTEXT_ADS
  BRANDING
  SMM
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CONVERTED
  REJECTED
}

enum LeadSource {
  TILDA
  MANUAL
}

model Lead {
  id           String     @id @default(cuid())
  status       LeadStatus @default(NEW)
  source       LeadSource @default(MANUAL)
  name         String?
  phone        String?
  email        String?
  companyName  String?
  message      String?
  formName     String?
  pageUrl      String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  utmTerm      String?
  // Номер заявки Тильды: защищает от дублей при повторной доставке
  externalId   String?    @unique
  // Все поля заявки как пришли, чтобы ничего не потерять при разборе
  raw          Json?
  owner        String?
  rejectReason String?
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId       String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
}

// Услуга из прайса агентства (progrs.ru/price)
model Product {
  id          String   @id @default(cuid())
  category    String
  name        String
  description String?
  price       Int // рубли
  // «от 150 000»: цена минимальная, итог зависит от проекта
  // Единица для почасовых и постраничных услуг: «час», «страница»
  unit        String?
  service     Service  @default(OTHER)
  // Шаг планограммы продаж (ключ из lib/sales-map.ts)
  salesStep   String?
  sortOrder   Int      @default(0)
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, sortOrder])
}

model Stage {
  id    String    @id @default(cuid())
  name  String
  order Int
  kind  StageKind @default(OPEN)
  deals Deal[]

  @@unique([order])
}

model Company {
  id          String         @id @default(cuid())
  name        String
  inn         String?
  kpp         String?
  ogrn        String?
  // Руководитель по данным ЕГРЮЛ: ФИО и должность
  director    String?
  website     String?
  phone       String?
  email       String?
  address     String?
  // Банковские реквизиты для договоров и счетов
  bankAccount String?
  corrAccount String?
  bankName    String?
  bik         String?
  notes       String?
  // Ситуация клиента в планограмме; пусто — определяется по оплаченным сделкам
  situation   String?
  contacts    Contact[]
  deals       Deal[]
  chats       Conversation[]
  documents   Document[]
  events      Event[]
  contracts   Contract[]
  // Ящик клиента в Диадоке: туда уходят акты
  diadocBoxId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([name])
}

model Contact {
  id        String   @id @default(cuid())
  fullName  String
  position  String?
  phone     String?
  email     String?
  notes     String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Deal {
  id                String     @id @default(cuid())
  title             String
  company           Company    @relation(fields: [companyId], references: [id])
  companyId         String
  // Контакт удаляется — сделка остаётся без контакта
  contact           Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId         String?
  // Услуга из прайса; сумма сделки копирует цену и дальше правится независимо
  product           Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId         String?
  quantity          Int        @default(1)
  amount            Int        @default(0) // рубли
  service           Service    @default(WEBSITE)
  salesStep         String?
  owner             String?
  // Когда начали работать по сделке; по умолчанию — дата создания
  startDate         DateTime   @default(now())
  expectedCloseDate DateTime?
  // Когда сделка оплачена или проиграна: по этой дате выручка попадает в месяц на дашборде
  closedAt          DateTime?
  lostReason        String?
  notes             String?
  // Порядок карточки внутри колонки: меньше — выше
  position          Float      @default(0)
  lead              Lead?
  documents         Document[]
  events            Event[]
  contracts         Contract[]
  stage             Stage      @relation(fields: [stageId], references: [id])
  stageId           String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([stageId, position])
  @@index([companyId])
}

// Настройки приёма заявок с Тильды: одна строка с id = 1
model TildaSettings {
  id         Int      @id @default(1)
  enabled    Boolean  @default(true)
  webhookKey String
  // Какие поля формы Тильды попадают в какие поля лида
  fieldMap   Json
  updatedAt  DateTime @updatedAt
}

// Журнал входящих запросов webhook: помогает настроить поля и понять, почему заявка не дошла
model WebhookLog {
  id        String   @id @default(cuid())
  source    String
  status    String
  fields    Json
  leadId    String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// Простые настройки приложения: ключи внешних сервисов и т. п.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Сотрудник CRM. Пока вход общий, владелец — один: его карточка в «Личных данных»
model Employee {
  id        String   @id @default(cuid())
  name      String
  position  String?
  phone     String?
  email     String?
  telegram  String?
  max       String?
  vk        String?
  instagram String?
  whatsapp  String?
  // Аватар как data URL: сжимается в браузере до 256 px, чтобы не держать файлы на диске
  avatar    String?
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Channel {
  TELEGRAM
  VK
  MAX
  WHATSAPP
  INSTAGRAM
}

enum MessageDirection {
  IN
  OUT
}

// Переписка с человеком в одном мессенджере: externalId — id чата на стороне мессенджера
model Conversation {
  id            String        @id @default(cuid())
  channel       Channel
  externalId    String
  name          String
  username      String?
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  unread        Int           @default(0)
  lastText      String?
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]
  createdAt     DateTime      @default(now())

  @@unique([channel, externalId])
  @@index([lastMessageAt])
  @@index([companyId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  direction      MessageDirection
  text           String
  // id сообщения в мессенджере: не даёт записать одно входящее дважды
  externalId     String?
  // Кто из CRM ответил
  author         String?
  createdAt      DateTime         @default(now())

  @@unique([conversationId, direction, externalId])
  @@index([conversationId, createdAt])
}

enum DocumentKind {
  INVOICE
  ACT
}

enum DocumentStatus {
  ISSUED
  PAID
  EXPIRED
}

// Счёт или акт, выставленный через Точку
model Document {
  id              String         @id @default(cuid())
  kind            DocumentKind
  // Порядковый номер в году: счёт № 12 от 26.10.2026
  year            Int
  seq             Int
  date            DateTime
  amount          Int
  title           String
  deal            Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId          String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  // Акт создаётся на основании счёта
  invoice         Document?      @relation("ActInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId       String?
  acts            Document[]     @relation("ActInvoice")
  tochkaId        String?
  status          DocumentStatus @default(ISSUED)
  paidAt          DateTime?
  payments        BankPayment[]
  // Черновик в Диадоке: id сообщения и когда загружен
  diadocMessageId String?
  diadocAt        DateTime?
  createdAt       DateTime       @default(now())

  @@unique([kind, year, seq])
  @@index([dealId])
}

// Поступление на расчётный счёт из выписки Точки
model BankPayment {
  id            String    @id @default(cuid())
  transactionId String    @unique
  date          DateTime
  amount        Int
  payerName     String?
  payerInn      String?
  purpose       String?
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentId    String?
  createdAt     DateTime  @default(now())

  @@index([date])
}

enum EventKind {
  MEETING
  TASK
}

// Событие календаря: встреча или задача, при желании привязанная к клиенту, сделке или другой задаче
model Event {
  id            String    @id @default(cuid())
  kind          EventKind @default(MEETING)
  title         String
  notes         String?
  start         DateTime
  end           DateTime
  // Событие на весь день: время в start и end не важно, только даты
  allDay        Boolean   @default(false)
  // Для задач: отметка о выполнении
  done          Boolean   @default(false)
  // За сколько минут до начала напомнить в Telegram; пусто — не напоминать
  remindMinutes Int?
  // Когда напоминание ушло: при переносе события сбрасывается
  remindedAt    DateTime?
  company       Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId     String?
  deal          Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  dealId        String?
  task          Event?    @relation("EventTask", fields: [taskId], references: [id], onDelete: SetNull)
  taskId        String?
  linked        Event[]   @relation("EventTask")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([start])
  @@index([companyId])
  @@index([dealId])
}

// Шаблон договора: HTML с полями вида {{клиент.инн}}, которые заполняются при создании договора
model ContractTemplate {
  id        String     @id @default(cuid())
  name      String
  body      String
  contracts Contract[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Договор: копия шаблона с подставленными данными; дальше правится сам по себе
model Contract {
  id         String            @id @default(cuid())
  number     String
  date       DateTime
  title      String
  body       String
  templateId String?
  template   ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  companyId  String?
  company    Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId     String?
  deal       Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([dealId])
  @@index([companyId])
}
