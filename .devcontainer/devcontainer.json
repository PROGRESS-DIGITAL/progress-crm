{
  // GitHub Codespaces: CRM с PostgreSQL и демо-данными для проверки, не для работы с реальными клиентами
  "name": "PROSTO CRM",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "DATABASE_URL": "postgresql://crm:crm@localhost:5432/progress_crm",
    "TILDA_WEBHOOK_KEY": "codespace-demo-key",
    "SEED_DEMO": "1"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "CRM", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm ci",
  "postAttachCommand": { "crm": "bash .devcontainer/start.sh" },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
